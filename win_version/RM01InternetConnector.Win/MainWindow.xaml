<Window x:Class="RM01InternetConnector.Win.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:RM01InternetConnector.Win"
        mc:Ignorable="d"
        Title="RM-01 Internet Connector"
        Width="380" Height="580"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Icon="Assets/icon.ico"
        Background="#F7F8FA"
        FontFamily="Segoe UI"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display">
    <Window.Resources>
        <LinearGradientBrush x:Key="ConnectBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#2DD45B" Offset="0"/>
            <GradientStop Color="#20A844" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="DisconnectBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#F27373" Offset="0"/>
            <GradientStop Color="#D95959" Offset="1"/>
        </LinearGradientBrush>
        <local:BooleanToBrushConverter x:Key="boolToBrushConverter"
                                       ConnectedBrush="{StaticResource DisconnectBrush}"
                                       DisconnectedBrush="{StaticResource ConnectBrush}"/>
        <local:InvertBoolConverter x:Key="invertBoolConverter"/>
        <local:BoolToVisibilityConverter x:Key="boolToVisibilityConverter"/>
        <local:BoolToOpacityConverter x:Key="boolToOpacityConverter"/>
        <local:BoolToOpacityBrushConverter x:Key="boolToOpacityBrushConverter"/>
        <Style x:Key="GlassButton" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                CornerRadius="8"
                                Background="{TemplateBinding Background}"
                                SnapsToDevicePixels="True"
                                BorderBrush="#50FFFFFF"
                                BorderThickness="1"
                                Opacity="{TemplateBinding Opacity}"
                                RenderTransformOrigin="0.5,0.5">
                            <Grid>
                                <Rectangle Height="20"
                                           VerticalAlignment="Top"
                                           IsHitTestVisible="False">
                                    <Rectangle.Fill>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#66FFFFFF" Offset="0"/>
                                            <GradientStop Color="#19FFFFFF" Offset="0.8"/>
                                        </LinearGradientBrush>
                                    </Rectangle.Fill>
                                </Rectangle>
                                <Rectangle Height="10"
                                           VerticalAlignment="Bottom"
                                           IsHitTestVisible="False">
                                    <Rectangle.Fill>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#00FFFFFF" Offset="0"/>
                                            <GradientStop Color="#33FFFFFF" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Rectangle.Fill>
                                </Rectangle>
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  Margin="{TemplateBinding Padding}"
                                                  RecognizesAccessKey="True"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.95"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.98" ScaleY="0.98"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="1"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="22,18,22,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Image Grid.Column="0"
                   Source="pack://application:,,,/Assets/icon.png"
                   Width="28"
                   Height="28"
                   Margin="0,0,10,0"
                   VerticalAlignment="Center"/>
            <TextBlock Grid.Column="1"
                       VerticalAlignment="Center"
                       FontWeight="SemiBold"
                       FontSize="18"
                       Foreground="#111827"
                       Text="{Binding WindowTitle}"
                       TextTrimming="CharacterEllipsis"/>
            <Button Grid.Column="2"
                    HorizontalAlignment="Right"
                    Command="{Binding ToggleLanguageCommand}"
                    Width="54"
                    Height="32"
                    Padding="6,0"
                    FontWeight="SemiBold"
                    BorderBrush="#22000000"
                    BorderThickness="1"
                    Background="#0F1BBA3F"
                    Foreground="#1B1B1B"
                    Cursor="Hand">
                <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Image Grid.Column="0"
                           Source="pack://application:,,,/Assets/translate.png"
                           Width="14"
                           Height="14"
                           HorizontalAlignment="Left"
                           VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1"
                               Text="{Binding LanguageLabel}"
                               FontSize="13"
                               VerticalAlignment="Center"/>
                </Grid>
            </Button>
        </Grid>

        <Rectangle Grid.Row="1" Height="1" Fill="#11000000" Margin="12,0"/>

        <!-- Status -->
        <StackPanel Grid.Row="2" Margin="22,18,22,8" HorizontalAlignment="Center">
            <TextBlock FontSize="30"
                       FontWeight="SemiBold"
                       Foreground="#111827"
                       Text="{Binding StatusText}"
                       HorizontalAlignment="Center"/>
            <TextBlock FontSize="15"
                       Foreground="#5B6472"
                       Text="{Binding InterfaceText}"
                       ToolTip="{Binding DeviceDescription}"
                       TextTrimming="CharacterEllipsis"
                       MaxWidth="310"
                       HorizontalAlignment="Center"/>
        </StackPanel>

        <!-- Device visual -->
        <Grid Grid.Row="3" Margin="0,2,0,4" MinHeight="230">
            <Image x:Name="DeviceImage"
                   Source="pack://application:,,,/Assets/body.png"
                   Stretch="Uniform"
                   Width="156"
                   MaxHeight="246"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   RenderOptions.BitmapScalingMode="HighQuality"/>
        </Grid>

        <!-- Speed display and Connect button -->
        <Grid Grid.Row="4" Margin="22,10,22,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            
            <!-- Network speed display -->
            <Border Grid.Row="0" 
                    Margin="0,0,0,12" 
                    Background="#19000000"
                    CornerRadius="8"
                    Width="224"
                    Height="36"
                    HorizontalAlignment="Center"
                    Visibility="{Binding IsConnected, Converter={StaticResource boolToVisibilityConverter}}">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <!-- Upload speed -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,12,0">
                        <Image Source="pack://application:,,,/Assets/arrow-drop-up-line.png" Width="14" Height="14" Margin="0,0,4,0"/>
                        <TextBlock Text="{Binding UploadSpeedText}" FontFamily="Consolas" FontSize="14"/>
                    </StackPanel>
                    
                    <TextBlock Text="|" Foreground="#66000000" FontSize="14" Margin="0,0,12,0"/>
                    
                    <!-- Download speed -->
                    <StackPanel Orientation="Horizontal">
                        <Image Source="pack://application:,,,/Assets/arrow-drop-down-line.png" Width="14" Height="14" Margin="0,0,4,0"/>
                        <TextBlock Text="{Binding DownloadSpeedText}" FontFamily="Consolas" FontSize="14"/>
                    </StackPanel>
                </StackPanel>
            </Border>
            
            <!-- Connect button -->
            <Button Grid.Row="1"
                    Style="{StaticResource GlassButton}"
                    Background="{Binding IsConnected, Converter={StaticResource boolToBrushConverter}, ConverterParameter='connect'}"
                    Command="{Binding ConnectCommand}"
                    IsEnabled="{Binding IsBusy, Converter={StaticResource invertBoolConverter}}"
                    Width="224"
                    Height="52"
                    HorizontalAlignment="Center">
                <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="26"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Image Grid.Column="0"
                           Source="pack://application:,,,/Assets/shut-down-line.png"
                           Width="16"
                           Height="16"
                           HorizontalAlignment="Left"
                           VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1"
                               Text="{Binding ButtonText}"
                               FontSize="16"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"/>
                </Grid>
            </Button>
        </Grid>

        <!-- Footer -->
        <TextBlock Grid.Row="5"
                   Margin="22,20,22,14"
                   HorizontalAlignment="Center"
                   TextAlignment="Center"
                   TextWrapping="Wrap"
                   Foreground="#88000000"
                   FontSize="11"
                   Text="Copyright © 2026 massif-01, RMinte AI Technology Co., Ltd."/>
    </Grid>
</Window>
