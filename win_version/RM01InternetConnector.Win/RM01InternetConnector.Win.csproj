<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets/icon.ico</ApplicationIcon>
    <AssemblyName>RM01InternetConnector</AssemblyName>
    <Version>1.1.5</Version>
    <Company>RMinte AI Technology Co., Ltd.</Company>
    <Product>RM-01 Internet Connector</Product>
    <Copyright>Copyright © 2026 massif-01, RMinte AI Technology Co., Ltd.</Copyright>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)'=='Release'">
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets/**" />
    <Content Include="..\tools\collect-windows-diagnostics.ps1" Link="collect-windows-diagnostics.ps1" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
